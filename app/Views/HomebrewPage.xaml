<Page x:Class="PkgRelay.Views.HomebrewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PkgRelay.Models"
    xmlns:motion="using:PkgRelay.Infrastructure"
    NavigationCacheMode="Required">
    <Page.Resources>
        <motion:HomebrewImageConverter x:Key="CatalogImageConverter"/>
        <ItemsPanelTemplate x:Key="WidePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="290"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TilePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="340"/></ItemsPanelTemplate>
        <Style x:Key="CatalogRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CatalogCardStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <ItemsPanelTemplate x:Key="RowSkeletonPanel"><ItemsStackPanel/></ItemsPanelTemplate>
        <DataTemplate x:Key="RowSkeleton"><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,8" MinWidth="280"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Height="56" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8"/><StackPanel Grid.Column="1" Spacing="10"><Border Height="14" Width="180" HorizontalAlignment="Left" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/><Border Height="12" Width="250" HorizontalAlignment="Left" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/><Border Height="12" Width="140" HorizontalAlignment="Left" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/></StackPanel></Grid></Border></DataTemplate>
        <DataTemplate x:Key="CardSkeleton"><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Width="280" Margin="0,0,10,10"><StackPanel Spacing="12"><Border Height="210" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6"/><Border Height="14" Width="180" HorizontalAlignment="Left" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/><Border Height="12" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/><Border Height="30" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"/></StackPanel></Border></DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="models:HomebrewApp">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56"><FontIcon Glyph="&#xE74C;" FontSize="28" Opacity="0.7"/><Image Source="{x:Bind ImageUrl, Mode=OneWay, Converter={StaticResource CatalogImageConverter}}" Stretch="Uniform" ImageFailed="CatalogImageFailed" ImageOpened="CatalogImageOpened"/></Grid>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind SecondaryText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind FirmwareText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind DateText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind SourceText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center"><ComboBox ItemsSource="{x:Bind Versions}" SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" DisplayMemberPath="VersionLabel" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose app version and firmware"/><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" Opacity="0.68"/></StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Install" Tag="{x:Bind}" Click="Install_Click"/><Button Tag="{x:Bind}" Click="Download_Click" AutomationProperties.Name="Download to PC" ToolTipService.ToolTip="Download to PC"><FontIcon Glyph="&#xE896;" FontSize="16"/></Button></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CardTemplate" x:DataType="models:HomebrewApp">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel Spacing="8">
                    <Border CornerRadius="6" Height="224" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE74C;" FontSize="64" Opacity="0.45"/><Image Source="{x:Bind ImageUrl, Mode=OneWay, Converter={StaticResource CatalogImageConverter}}" Stretch="UniformToFill" ImageFailed="CatalogImageFailed" ImageOpened="CatalogImageOpened"/></Grid></Border>
                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                    <ComboBox ItemsSource="{x:Bind Versions}" SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" DisplayMemberPath="VersionLabel" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose app version and firmware"/>
                    <TextBlock Text="{x:Bind FirmwareText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind DateText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Install" Tag="{x:Bind}" Click="Install_Click"/><Button Tag="{x:Bind}" Click="Download_Click" AutomationProperties.Name="Download to PC" ToolTipService.ToolTip="Download to PC"><FontIcon Glyph="&#xE896;" FontSize="16"/></Button></StackPanel><Button Grid.Column="1" AutomationProperties.Name="App details"><FontIcon Glyph="&#xE946;" FontSize="16"/><Button.Flyout><Flyout><StackPanel MaxWidth="330" Spacing="8"><TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind SourceText, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind SizeText, Mode=OneWay}"/></StackPanel></Flyout></Button.Flyout></Button></Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TileTemplate" x:DataType="models:HomebrewApp">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Width="40" Height="40"><FontIcon Glyph="&#xE74C;" FontSize="28" Opacity="0.6"/><Image Source="{x:Bind ImageUrl, Mode=OneWay, Converter={StaticResource CatalogImageConverter}}" Stretch="Uniform" ImageFailed="CatalogImageFailed" ImageOpened="CatalogImageOpened"/></Grid>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind DateText, Mode=OneWay}" Opacity="0.68" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Opacity="0.68"/></StackPanel>
                    <Button Grid.Column="2" Tag="{x:Bind}" AutomationProperties.Name="App actions"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><Flyout><StackPanel Spacing="8"><Button Content="Install" Tag="{x:Bind}" Click="Install_Click"/><Button Content="Download to PC" Tag="{x:Bind}" Click="Download_Click"/><TextBlock Text="{x:Bind FirmwareText, Mode=OneWay}" MaxWidth="260" TextWrapping="Wrap"/><TextBlock Text="{x:Bind SourceText, Mode=OneWay}" MaxWidth="260" TextWrapping="Wrap"/></StackPanel></Flyout></Button.Flyout></Button>
                    <ComboBox Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{x:Bind Versions}" SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}" DisplayMemberPath="VersionLabel" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose app version and firmware"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="24,0,24,24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Homebrew" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="ProviderText" Text="Official project releases" Opacity="0.68"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Connect full catalog" Click="ConnectCatalog_Click"/><Button Content="Import catalog" Click="ImportCatalog_Click" ToolTipService.ToolTip="Import store.db or a JSON catalog saved through your browser"/></StackPanel></Grid>
        <InfoBar x:Name="HomebrewInfoBar" Grid.Row="1" IsOpen="False" motion:InfoBarMotion.IsEnabled="True"/>
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search names, authors, or title IDs" QueryIcon="Find" MaxWidth="560" HorizontalAlignment="Left" MinWidth="300" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search Homebrew"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="ListViewButton" Tag="0" Click="View_Click" AutomationProperties.Name="List view" ToolTipService.ToolTip="List view"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></ToggleButton>
                <ToggleButton x:Name="GridViewButton" Tag="1" Click="View_Click" AutomationProperties.Name="Grid view" ToolTipService.ToolTip="Grid view"><FontIcon Glyph="&#xE80A;" FontSize="16"/></ToggleButton>
                <ToggleButton x:Name="TileViewButton" Tag="2" Click="View_Click" AutomationProperties.Name="Tile view" ToolTipService.ToolTip="Tile view"><FontIcon Glyph="&#xECA5;" FontSize="16"/></ToggleButton>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultCountText" Text="Loading catalog…" VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Filter by:" VerticalAlignment="Center" Opacity="0.68"/>
                <ComboBox x:Name="CategoryBox" Width="170" SelectionChanged="Options_Changed" AutomationProperties.Name="Filter Homebrew category"/>
                <TextBlock Text="Sort by:" VerticalAlignment="Center" Opacity="0.68"/>
                <ComboBox x:Name="SortBox" Width="185" SelectionChanged="Options_Changed" AutomationProperties.Name="Sort Homebrew">
                    <ComboBoxItem Content="Name (A–Z)"/><ComboBoxItem Content="Name (Z–A)"/><ComboBoxItem Content="Newest first"/><ComboBoxItem Content="Size (smallest)"/><ComboBoxItem Content="Size (largest)"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4"><Grid x:Name="SkeletonHost" Visibility="Collapsed"><ListView x:Name="SkeletonList" SelectionMode="None" IsHitTestVisible="False" ItemContainerStyle="{StaticResource CatalogRowStyle}" ItemTemplate="{StaticResource RowSkeleton}" ItemsPanel="{StaticResource RowSkeletonPanel}"/></Grid>
            <ListView x:Name="HomebrewList" SelectionMode="None" ItemContainerStyle="{StaticResource CatalogRowStyle}" ItemTemplate="{StaticResource RowTemplate}"/>
            <GridView x:Name="HomebrewGrid" SelectionMode="None" Visibility="Collapsed" ItemContainerStyle="{StaticResource CatalogCardStyle}" ItemTemplate="{StaticResource CardTemplate}">
            </GridView>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="36" Opacity="0.6"/>
                <TextBlock x:Name="EmptyTitle" Text="No matching Homebrew" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyMessage" Text="Try another search or category." Opacity="0.68" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="450"/>
            </StackPanel>
            <ProgressRing x:Name="LoadingRing" Width="40" Height="40" Visibility="Collapsed" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
