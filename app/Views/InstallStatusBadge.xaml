<UserControl
    x:Class="PkgRelay.Views.InstallStatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:PkgRelay.Converters">
    <UserControl.Resources>
        <infra:InstallStatusBrushConverter x:Key="StatusBrush"/>
    </UserControl.Resources>
    <Border x:Name="BadgeBackground" Padding="8,3" CornerRadius="10"
        Background="{x:Bind Job.Status, Mode=OneWay, Converter={StaticResource StatusBrush}}">
        <TextBlock x:Name="BadgeLabel" FontSize="12" HorizontalAlignment="Center"
            Text="{x:Bind Job.StatusText, Mode=OneWay}"
            Foreground="{x:Bind Job.Status, Mode=OneWay, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}"/>
    </Border>
</UserControl>
