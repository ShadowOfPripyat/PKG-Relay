<UserControl
    x:Class="PkgRelay.Views.FpkgiDatabaseTool"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:PkgRelay.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,12,24">
            <StackPanel Spacing="4">
                <TextBlock Text="FPKGi databases" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Download and manage Games, DLC and Homebrew catalogs for FPKGi." TextWrapping="Wrap" Opacity="0.72"/>
            </StackPanel>
            <InfoBar x:Name="DatabaseInfoBar" IsOpen="False" motion:InfoBarMotion.IsEnabled="True"/>
            <ProgressBar x:Name="DatabaseProgress" Visibility="Collapsed" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="DatabaseProgressText" Visibility="Collapsed" TextWrapping="Wrap"/>
            <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/>
            <ContentControl x:Name="DatabaseActions" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <CheckBox x:Name="GamesCheckBox" Content="Games" IsChecked="True"/>
                        <TextBlock x:Name="GamesStatus" Text="Not downloaded" Margin="32,-8,0,0" TextWrapping="Wrap" Opacity="0.7"/>
                        <CheckBox x:Name="DlcCheckBox" Content="DLC" IsChecked="True"/>
                        <TextBlock x:Name="DlcStatus" Text="Not downloaded" Margin="32,-8,0,0" TextWrapping="Wrap" Opacity="0.7"/>
                        <CheckBox x:Name="HomebrewCheckBox" Content="Homebrew"/>
                        <TextBlock x:Name="HomebrewStatus" Text="Generate from the Homebrew catalog or import a file" Margin="32,-8,0,0" TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <Button Content="Download / update Games and DLC" Click="Download_Click" ToolTipService.ToolTip="Download the selected Games and DLC databases; validate both before replacing working files"/>
                    <Button Content="Generate Homebrew database" Click="GenerateHomebrew_Click" ToolTipService.ToolTip="Use the latest stable Homebrew versions from the current catalog"/>
                    <Button Content="Validate selected databases" Click="Validate_Click"/>
                    <Button Content="Open database folder" Click="OpenFolder_Click"/>
                    <Button x:Name="UploadButton" Content="Send selected databases to PS4" Click="Upload_Click" Visibility="Collapsed"/>
                </StackPanel>
                <Expander Header="Import or restore a database" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Choose the database to replace. Existing local files are backed up automatically." TextWrapping="Wrap"/>
                        <ComboBox x:Name="ImportKindBox" SelectedIndex="0" AutomationProperties.Name="Database type">
                            <ComboBoxItem Content="Games — GAMES.json"/><ComboBoxItem Content="DLC — DLC.json"/><ComboBoxItem Content="Homebrew — HOMEBREW.json"/>
                        </ComboBox>
                        <Button Content="Import JSON file" Click="Import_Click"/>
                        <Button Content="Restore previous local version" Click="Restore_Click"/>
                    </StackPanel>
                </Expander>
                <Expander Header="Download sources" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="GamesSourceBox" Header="Games database URL" TextWrapping="Wrap"/>
                        <TextBox x:Name="DlcSourceBox" Header="DLC database URL" TextWrapping="Wrap"/>
                        <Button Content="Save sources" Click="SaveSources_Click"/>
                        <Button Content="Use default Archive.org sources" Click="Defaults_Click"/>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Open FPKGi once on the PS4. Enable GoldHEN's FTP server for transfers. Databases belong in /user/data/FPKGi/ContentJSONs/. Close FPKGi before replacing them, then reopen it. Use Direct Download in FPKGi for GitHub packages." TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.72"/>
                <TextBlock x:Name="DatabaseFolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.65"/>
            </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
