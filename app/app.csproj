<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <RootNamespace>PkgRelay</RootNamespace>
    <AssemblyName>app</AssemblyName>
    <Product>PKG Relay</Product>
    <AssemblyTitle>PKG Relay</AssemblyTitle>
    <Description>PKG Relay for PS4 Remote Package Installer.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>

    <!--
      DEVELOPMENT DEPLOYMENT MODEL

      Use the Windows App SDK runtime installed on the development machine.
      Do NOT mix self-contained app-local Windows App Runtime files with the
      framework/bootstrapper path. That combination can load duplicate WinUI /
      CoreMessaging runtime components and terminate with STATUS_FAIL_FAST_EXCEPTION
      (0xC0000602) before App.OnLaunched is reached.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>

    <!-- Required for framework-dependent unpackaged apps. -->
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>

    <!-- Not used by this app; disabling these avoids unnecessary runtime init. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
